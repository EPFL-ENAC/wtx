{
  "*": "ask",
  "read": {
    "*": "allow",
    "*.env": "deny",
    "*.pem": "deny",
    "*.key": "deny",
    "**/.ssh/**": "deny",
    "**/.gnupg/**": "deny",
    "**/.aws/**": "deny"
  },
  "lsp": "allow",
  "glob": "allow",
  "list": "allow",
  "grep": "allow",
  "edit": "allow",
  "write": "allow",
  "patch": "allow",
  "webfetch": "ask",
  "external_directory": {
    "*": "ask"
  },
  "bash": {
    "*": "ask",
    "ls *": "allow",
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "find *": "allow",
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git branch*": "allow",
    "git add *": "allow",
    "git commit *": "allow",
    "git fetch*": "allow",
    "git push --force*": "deny",
    "git push -f *": "deny",
    "git remote set-url *": "deny",
    "git remote add *": "deny",
    "claude *": "deny",
    "wtx install-machine*": "deny",
    "sudo *": "deny",
    "rm -rf /*": "deny",
    "eval *": "ask",
    "curl *-X*": "ask",
    "curl *--request *": "ask",
    "curl *-d *": "ask",
    "curl *--data*": "ask",
    "curl *-F *": "ask",
    "curl *--form*": "ask",
    "curl *-T *": "ask",
    "curl *--upload-file *": "ask",
    "curl *--json *": "ask",
    "wtx curl *": "allow",
    "curl *": "allow",
    "gh pr create *": "ask",
    "gh pr merge *": "ask",
    "gh release *": "ask",
    "gh repo *": "ask",
    "npx -y *": "ask",
    "uvx *": "ask",
    "pipx run *": "ask",
    "pip install http*": "ask",
    "pip install git+*": "ask",
    "chmod +x *": "ask"
  }
}
